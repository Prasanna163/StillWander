{
  "schemaVersion": 1,
  "id": "stillwander",
  "version": "${version}",
  "name": "Still Wander",
  "description": "Stand still and let an environment-aware cinematic camera explore your Minecraft world.",
  "authors": [
    "Prasanna163"
  ],
  "contact": {
    "homepage": "https://github.com/Prasanna163/StillWander",
    "sources": "https://github.com/Prasanna163/StillWander",
    "issues": "https://github.com/Prasanna163/StillWander/issues"
  },
  "license": "LicenseRef-All-Rights-Reserved",
  "icon": "assets/stillwander/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.cinecraft.CinecraftClient"
    ],
    "frex_flawless_frames": [
      "com.cinecraft.compat.CinecraftFlawlessFrames"
    ]
  },
  "mixins": [
    "stillwander.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "breaks": {
    "cinecraft": "*"
  }
}
